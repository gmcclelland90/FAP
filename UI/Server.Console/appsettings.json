{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
  ,
  "Fap": {
    "Web": {
      "EnableCompression": true,
      "EnableCaching": true,
      "EnableRateLimiting": true,
      "StaticFilesCacheSeconds": 86400,
      "Listen": {
        "Address": "0.0.0.0",
        "Port": 40
      },
      "KestrelLimits": {
        "MaxConcurrentConnections": 200,
        "MaxRequestBodySize": 104857600,
        "KeepAliveTimeout": "00:02:00",
        "RequestHeadersTimeout": "00:00:30"
      }
    }
  }
}

