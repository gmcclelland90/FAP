<Window x:Class="Fap.Presentation.MessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="FAP" SizeToContent="WidthAndHeight" MinWidth="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBox Text="{Binding Response}" Grid.Row="1" Grid.ColumnSpan="2" Height="25" Margin="8" />
        <TextBlock   Text="{Binding Message}"  VerticalAlignment="Center"  HorizontalAlignment="Center" Grid.ColumnSpan="2"  TextWrapping="Wrap" />
        <Button Content="Ok" Grid.Row="2" Width="100"  Height="30" Margin="8" Click="Button_Click" />
        <Button Content="Cancel" Grid.Row="2" Grid.Column="1" Width="100"  Height="30" Margin="8" Click="Button_Click_1" />
    </Grid>
</Window>
