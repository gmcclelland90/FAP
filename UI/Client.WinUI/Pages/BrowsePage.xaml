<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Fap.Client.WinUI.Pages.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AutomationProperties.AutomationId="browse.root" Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                Text="Browse"
                FontSize="28"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="BrowseStatus"
                AutomationProperties.AutomationId="browse.status"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <TabView
            x:Name="PeerTabs"
            Grid.Row="1"
            AutomationProperties.AutomationId="browse.peerTabs"
            IsAddTabButtonVisible="False"
            TabCloseRequested="PeerTabs_TabCloseRequested"
            Visibility="Collapsed" />

        <ScrollViewer
            x:Name="EmptyState"
            Grid.Row="1"
            AutomationProperties.AutomationId="browse.empty"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Open a peer share"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Select a peer below to walk their folders and queue downloads. You can also open peers from Home."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="GoHomeButton"
                                Content="Go to Home"
                                AutomationProperties.AutomationId="browse.goHome"
                                Click="GoHomeButton_Click" />
                            <Button
                                x:Name="RefreshPeersButton"
                                Content="Refresh peers"
                                AutomationProperties.AutomationId="browse.refreshPeers"
                                Click="RefreshPeersButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="16,14,16,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Online peers" />
                        <ListView
                            x:Name="PeerPicker"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="browse.peerPicker"
                            AutomationProperties.Name="Online peers"
                            MinHeight="120"
                            MaxHeight="320"
                            Padding="4,0,4,8"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="PeerPicker_ItemClick" />
                        <StackPanel
                            x:Name="PeerPickerEmpty"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Padding="24"
                            Visibility="Collapsed">
                            <TextBlock
                                Text="No other peers online"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="When peers join the mesh they show up here."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                HorizontalAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
