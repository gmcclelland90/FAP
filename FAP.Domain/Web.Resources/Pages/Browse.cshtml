@* 
    Browse page template - Razor syntax version of the FAP file browser.
    This .cshtml serves as the source-of-truth for the HTML structure.
    It is compiled into BrowsePageRenderer.cs for runtime use.
    Model type: FAP.Domain.Models.BrowsePageData
*@
@model FAP.Domain.Models.BrowsePageData
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" type="image/ico" href="/Fap.app.web/favicon.ico" />
    <title>@Model.Nickname's Web share</title>
    <style type="text/css">
        @@import "/Fap.app.web/css/fap.css";
    </style>
    <script src="/Fap.app.web/js/jquery-1.5.2.min.js"></script>
    <script src="/Fap.app.web/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#files').dataTable({
                "bPaginate": false,
                "aaSorting": [],
                "oLanguage": {
                    "sZeroRecords": "No files or folders found!"
                },
                "aoColumns": [
                    { "sWidth": "1px", "iDataSort": 6 },
                    null,
                    { "sWidth": "80px", "iDataSort": 4 },
                    { "sWidth": "80px", "iDataSort": 5 },
                    null,
                    null,
                    null
                ]
            });
        })
    </script>
</head>
<body id="body">
    <div id="container">
        <div class="full_width big">
            <h1>@Model.Nickname's Shares</h1>
        </div>

        <p>
            <span class="@Model.SlotColour">
                @Model.FreeUploadSlots of @Model.MaxUploadSlots upload slots available
            </span>.@Model.QueueInfo
            Files under @Model.FreeLimit are not queued.
        </p>

        <p><i>Please note that if the server runs out of upload slots then your download will stall until a free slot is available.</i></p>

        <h2>Current Path:</h2>

        <div>
            <a href="/">Root</a>
            @foreach (var segment in Model.PathSegments)
            {
                <span class="PathSplitter">/</span>
                <a href="@segment.Path">@segment.Name</a>
            }
        </div>

        <div id="demo">
            <table cellpadding="0" cellspacing="0" border="0" class="display" id="files">
                <thead>
                    <tr>
                        <th>Icon</th>
                        <th>Name</th>
                        <th>Modified</th>
                        <th>Size</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model.Files)
                    {
                        <tr class="even">
                            <td>
                                @Html.Raw(file.IconHtml)
                                <a title="Download via FAP" href="fap://@(Model.NodeId)@(Model.CurrentPath)@(file.Path)">
                                    <img alt="FAP Download" src="/Fap.app.web/images/fap.png" class="fapDownload" />
                                </a>
                            </td>
                            <td><a href="@(Model.CurrentPath)@(file.Path)">@file.Name</a></td>
                            <td>@file.LastModifiedText</td>
                            <td class="center">@file.SizeText</td>
                            <td class="hidden">@file.LastModified</td>
                            <td class="hidden">@file.Size</td>
                            <td class="hidden">@file.Icon</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Icon</th>
                        <th>Name</th>
                        <th>Modified</th>
                        <th>Size</th>
                    </tr>
                </tfoot>
            </table>
            <div style="text-align:center">
                Total Size: @Model.TotalSize
            </div>
            <div class="spacer"></div>
            <div style="text-align:center">
                Page generated by @Model.AppVersion
            </div>
        </div>
    </div>
</body>
</html>
