<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>FAP.Domain</RootNamespace>
    <AssemblyName>FAP.Domain</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="NLog" Version="6.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FAP.Foundation\FAP.Foundation.csproj" />
    <ProjectReference Include="..\FAP.Network\FAP.Network.csproj" />
    <ProjectReference Include="..\FAP.Shared\FAP.Shared.csproj" />
    <ProjectReference Include="..\libs\HttpServer\HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Web.Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>